# Real-API E2E suite (pnpm test:e2e:real). Copy this file to ".env.e2e" (git-ignored) and fill it in.
# The mock suite (pnpm test:e2e:mock) needs none of this.

# Front end the browser opens. The Vite dev server you already run with "pnpm dev" is reused (and left running);
# the API it talks to is the VITE_API_URL of your .env.
PLAYWRIGHT_BASE_URL=http://localhost:5173

# A CUSTOMER account of that backend. The tests create a horse/booking with an "E2E Smoke" name on it and remove them again.
# Use a dedicated test account, never a personal or production one, and never commit the filled-in file.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

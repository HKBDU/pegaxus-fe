# Backend API URL (not the frontend development server)
VITE_API_URL=http://localhost:5000/api/v1
# Development-only profile mock. Set to false to use the authenticated backend.
VITE_USE_MOCK_PROFILE=false
# Optional development-only bearer token for Booking Status History API smoke tests.
# Put a fresh token in .env.local; never commit a token.
VITE_BOOKING_API_MOCKS=false

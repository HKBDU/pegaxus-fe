# Official development backend
VITE_API_URL=https://pegaxus-be-dev.onrender.com/api/v1/
# Geoapify key for map, geocoding and routing (used by the route plan screens).
VITE_GEOAPIFY_API_KEY=
# Development-only profile mock. Set to false to use the authenticated backend.
VITE_USE_MOCK_PROFILE=false
# Optional development-only bearer token for Booking Status History API smoke tests.
# Put a fresh token in .env.local; never commit a token.
VITE_BOOKING_API_MOCKS=false
# Optional local-only mock data for Flow 2 catalog, dossier, dashboard, and audit screens.
# Omit this variable or set it to false to use the backend API.
VITE_COMPLIANCE_API_MOCKS=false
# Flow 3 personnel assignment (UC-36): mocks are ON in development when this is unset (always OFF in production builds).
# Set to false to call the real API
VITE_PERSONNEL_API_MOCKS=false
VITE_INVOICE_API_MOCKS=false
VITE_HORSE_HEALTH_MOCK=false

# Development-only Emergency Cost CO1/CO2/CO3 demo. Missing/invalid values and production use real APIs.
VITE_ENABLE_FLOW5_MOCKS=false

# SignalR notification hub. Optional: defaults to the API origin + /hubs/notifications (VITE_API_URL without /api/v1).
# VITE_SIGNALR_HUB_URL=http://localhost:5001/hubs/notifications
